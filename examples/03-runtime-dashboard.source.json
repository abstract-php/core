{
  "main": {
    "@": {
      "class": "dashboard"
    },
    "#": [
      {
        ":if": {
          "@": {
            "test": {
              ":logic:eq": [
                {
                  ":logic:var": "user.role"
                },
                {
                  ":type:string": "admin"
                }
              ]
            }
          },
          "#": [
            {
              "h1": "Admin Dashboard"
            },
            {
              "ul": [
                {
                  ":each": {
                    "@": {
                      "items": {
                        ":logic:var": "tasks"
                      },
                      "as": "task"
                    },
                    "#": [
                      {
                        "li": {
                          ":logic:var": "task.label"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          ":else": [
            {
              "p": "Please sign in with an admin account."
            }
          ]
        }
      }
    ]
  }
}
